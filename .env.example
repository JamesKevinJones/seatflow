# Copy to .env before `docker compose up`. Compose reads .env automatically.
#
# The backend refuses to start without the two secrets below rather than
# falling back to a default, because a guessable signing key is worse than a
# failed boot.

# At least 32 characters - HS256 needs 256 bits.
SEATFLOW_JWT_SECRET=change-me-to-something-long-and-random-at-least-32-chars

# The bootstrap administrator, created on first start.
SEATFLOW_ADMIN_EMAIL=admin@seatflow.local
SEATFLOW_ADMIN_PASSWORD=change-me

# Optional.
POSTGRES_PASSWORD=seatflow
SEATFLOW_PORT=8088
